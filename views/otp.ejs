<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Email Verification</title>
  <style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

:root {
  --primary: #6366f1;
  --secondary: #8b5cf6;
  --bg: #f4f6fb;
  --card: #ffffff;
  --text: #1f2937;
  --muted: #6b7280;
}

/* Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Inter', sans-serif;
}

body {
  min-height: 100vh;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
}

/* Navbar */
nav {
  padding: 20px 40px;
}

.logo {
  color: #ffffff;
  font-size: 26px;
  font-weight: 700;
}

.logo span {
  color: #ffd369;
}

/* Layout */
.otp-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: calc(100vh - 80px);
  padding: 20px;
}

/* Card */
.otp-card {
  background: var(--card);
  width: 100%;
  max-width: 520px;
  padding: 36px;
  border-radius: 22px;
  text-align: center;
  box-shadow: 0 30px 60px rgba(0, 0, 0, 0.25);
}

/* Headings */
.otp-card h2 {
  font-size: 26px;
  margin-bottom: 10px;
  color: var(--text);
}

.subtitle {
  font-size: 15px;
  color: var(--muted);
  margin-bottom: 28px;
  line-height: 1.5;
}

/* OTP Layout */
.otp-inputs {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 22px;
}

.otp-inputs input {
  width: 100%;
  max-width: 300px;
  height: 56px;
  font-size: 20px;
  font-weight: 600;
  text-align: center;
  border-radius: 14px;
  border: 1px solid #e5e7eb;
  outline: none;
  transition: 0.3s;
}

.otp-inputs input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
}

/* Button */
button {
  width: 100%;
  max-width: 260px;
  padding: 14px;
  border-radius: 14px;
  border: none;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: #ffffff;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: 0.3s;
}

button:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(99, 102, 241, 0.45);
}

/* Mobile Fix (THIS fixes your issue) */
@media (max-width: 640px) {
  nav {
    padding: 16px 20px;
  }

  .otp-card {
    padding: 26px;
    border-radius: 18px;
  }

  .otp-inputs {
    flex-direction: column;
    gap: 12px;
  }

  .otp-inputs input {
    max-width: 100%;
  }

  button {
    max-width: 100%;
  }

  .resend {
    text-align: center;
  }
}

/* Small Phones */
@media (max-width: 400px) {
  .otp-card h2 {
    font-size: 22px;
  }

  .subtitle {
    font-size: 14px;
  }
}
  </style>
</head>
<body>

  <nav>
    <h1 class="logo">Todo<span>Pro</span></h1>
  </nav>

  <div class="otp-container">
    <div class="otp-card">
      <h2>Verify Your Email</h2>
      <p class="subtitle">
        We’ve sent a 6-digit OTP to your email.<br />
        Please enter it below to continue.
      </p>

      <form action="/otp/<%=userId%>" method="post">
        <div class="otp-inputs">
          <input type="text" name="otp" maxlength="6" required />

        <button type="submit">Verify OTP</button>
      </form>
    </div>
  </div>

</body>
</html>
